{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/asset-review-watch.sh",
            "args": ["watch"],
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/asset-review-watch.sh",
            "args": ["watch"],
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ]
  }
}
