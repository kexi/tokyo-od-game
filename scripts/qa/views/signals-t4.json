        "id": "day",
        "time": "day",
        "moment": "2026-11-10T11:00:00+09:00"
      },
      {
        "id": "night",
        "time": "night",
        "moment": "2026-11-10T21:30:00+09:00"
      }
    ],
    "hide": ["traffic"]
  },
